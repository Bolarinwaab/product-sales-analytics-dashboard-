/* EMMTEC SYSTEMS — POWER BI EXECUTIVE MEASURE PACK
   Semantic model: FactSales + DimDate + DimCustomer + DimProduct + DimGeography + DimShipping + DimDiscount.
   Benchmark-safe: no confidential company data is embedded.
*/

Revenue = SUM(FactSales[Sales])
Gross Profit = SUM(FactSales[Profit])
Profit Margin = DIVIDE([Gross Profit], [Revenue])
Units Sold = SUM(FactSales[Quantity])
Orders = DISTINCTCOUNT(FactSales[OrderID])
Customers = DISTINCTCOUNT(FactSales[CustomerKey])
Average Order Value = DIVIDE([Revenue], [Orders])
Revenue per Customer = DIVIDE([Revenue], [Customers])

Revenue PY = CALCULATE([Revenue], SAMEPERIODLASTYEAR(DimDate[Date]))
Revenue YoY % = DIVIDE([Revenue] - [Revenue PY], [Revenue PY])
Profit PY = CALCULATE([Gross Profit], SAMEPERIODLASTYEAR(DimDate[Date]))
Profit YoY % = DIVIDE([Gross Profit] - [Profit PY], [Profit PY])
Units PY = CALCULATE([Units Sold], SAMEPERIODLASTYEAR(DimDate[Date]))
Units YoY % = DIVIDE([Units Sold] - [Units PY], [Units PY])

Discounted Revenue = CALCULATE([Revenue], DimDiscount[DiscountBand] <> "None")
Discounted Revenue % = DIVIDE([Discounted Revenue], [Revenue])
High Discount Revenue = CALCULATE([Revenue], DimDiscount[DiscountBand] = "High")
High Discount Profit = CALCULATE([Gross Profit], DimDiscount[DiscountBand] = "High")
High Discount Margin = DIVIDE([High Discount Profit], [High Discount Revenue])

Loss-Making Revenue = CALCULATE([Revenue], FactSales[Profit] < 0)
Loss-Making Revenue % = DIVIDE([Loss-Making Revenue], [Revenue])
Top Country = CONCATENATEX(TOPN(1, VALUES(DimGeography[Country]), [Revenue], DESC), DimGeography[Country], ", ")
Top Product = CONCATENATEX(TOPN(1, VALUES(DimProduct[ProductName]), [Revenue], DESC), DimProduct[ProductName], ", ")
Best Discount Band = CONCATENATEX(TOPN(1, VALUES(DimDiscount[DiscountBand]), [Profit Margin], DESC), DimDiscount[DiscountBand], ", ")

Performance Status =
SWITCH(TRUE(),
    [Profit Margin] < 0, "Loss",
    [Profit Margin] < 0.10, "Margin Risk",
    [Revenue YoY %] < 0, "Revenue Decline",
    "Healthy")
